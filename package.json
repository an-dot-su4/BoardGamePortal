{
  "name": "boardgameportal",
  "private": true,
  "type": "module",
  "description": "部屋番号で集まって遊べるブラウザボードゲームポータル",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "e2e": "node tests/e2e.mjs",
    "e2e:games": "node tests/e2e-games.mjs",
    "serve": "npx --yes http-server -p 8080 -c-1 .",
    "build:vendor": "esbuild tools/trystero-entry.js --bundle --format=esm --minify --target=es2020 --outfile=vendor/trystero.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.56.1",
    "trystero": "0.26.0"
  }
}
